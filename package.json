{
  "name": "campuspass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "hardhat test --no-compile",
    "test:backend": "hardhat test test/BackendAndIndexer.js --no-compile",
    "test:postgres": "node server/tests/postgres.integration.test.js",
    "db:validate": "node server/src/utils/prismaSchemaValidator.js",
    "db:generate": "npm --prefix server run db:generate",
    "db:migrate": "npm --prefix server run db:migrate",
    "dev:server": "node --watch server/src/index.js",
    "start:server": "node server/src/index.js",
    "dev:indexer": "node server/src/indexer/runIndexer.js",
    "check:monad": "hardhat run scripts/check-balance.js --network monadTestnet",
    "deploy:monad": "hardhat run scripts/deploy.js --network monadTestnet",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "ethers": "^6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hardhat": "^3.21.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
