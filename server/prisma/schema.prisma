// CampusPass — Faz 9 PostgreSQL & Prisma Veri Modeli
// Ağ: Monad Testnet (Chain ID: 10143)
// Sözleşme: 0x12C8B599b2c34dB66Ba942Da818f056Ae6B1a8da

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  REMOVED
}

/// Üniversite öğrenci toplulukları / kulüpleri modeli (Faz 12)
model Community {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  name                 String            @unique
  description          String?
  shortDescription     String?
  universityName       String            @default("Monad Üniversitesi")
  category             String            @default("Genel")
  logoUrl              String?
  coverImageUrl        String?
  websiteUrl           String?
  contactEmail         String?
  createdByWallet      String            @default("")
  leadOrganizerAddress String
  status               String            @default("ACTIVE")
  verified             Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  events               EventMetadata[]
  members              CommunityMember[]

  @@index([leadOrganizerAddress])
  @@index([createdByWallet])
  @@index([status])
  @@index([category])
}

/// Topluluk üyelik ve yetkilendirme modeli (Faz 12)
model CommunityMember {
  id            String           @id @default(cuid())
  communityId   String
  walletAddress String
  role          CommunityRole    @default(MEMBER)
  status        MembershipStatus @default(PENDING)
  joinedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  community     Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, walletAddress], name: "community_member_unique")
  @@index([walletAddress])
  @@index([communityId])
  @@index([status])
  @@index([role])
}

/// Zincir dışı genişletilmiş etkinlik metadata modeli
model EventMetadata {
  id                   String                @id @default(cuid())
  chainId              Int
  contractAddress      String
  eventId              Int
  organizerAddress     String
  title                String?
  capacity             Int?
  description          String
  community            String
  communityId          String?
  category             String
  startAt              DateTime
  endAt                DateTime
  registrationDeadline DateTime
  campus               String
  building             String
  room                 String
  posterUrl            String?
  cancelled            Boolean               @default(false)
  cancelReason         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  communityRef         Community?            @relation(fields: [communityId], references: [id], onDelete: SetNull)
  registrations        IndexedRegistration[]
  attendances          IndexedAttendance[]

  @@unique([chainId, contractAddress, eventId], name: "chainId_contractAddress_eventId")
  @@index([organizerAddress])
  @@index([category])
  @@index([community])
  @@index([startAt])
}

/// Blokzincir üzerindeki UserRegistered olaylarının indekslenmiş tablosu
model IndexedRegistration {
  id                 String              @id @default(cuid())
  chainId            Int
  contractAddress    String
  eventId            Int
  participantAddress String
  transactionHash    String
  blockNumber        Int
  logIndex           Int
  createdAt          DateTime            @default(now())

  eventMetadata      EventMetadata?      @relation(fields: [chainId, contractAddress, eventId], references: [chainId, contractAddress, eventId], onDelete: Restrict, onUpdate: Cascade)
  attendance         IndexedAttendance?

  @@unique([chainId, contractAddress, transactionHash, logIndex], name: "reg_tx_log_unique")
  @@unique([chainId, contractAddress, eventId, participantAddress], name: "reg_event_participant_unique")
  @@index([participantAddress])
  @@index([chainId, contractAddress, eventId])
  @@index([blockNumber])
}

/// Blokzincir üzerindeki AttendanceMarked olaylarının indekslenmiş tablosu
model IndexedAttendance {
  id                 String                 @id @default(cuid())
  chainId            Int
  contractAddress    String
  eventId            Int
  participantAddress String
  transactionHash    String
  blockNumber        Int
  logIndex           Int
  createdAt          DateTime               @default(now())

  eventMetadata      EventMetadata?         @relation(fields: [chainId, contractAddress, eventId], references: [chainId, contractAddress, eventId], onDelete: Restrict, onUpdate: Cascade)
  registration       IndexedRegistration?   @relation(fields: [chainId, contractAddress, eventId, participantAddress], references: [chainId, contractAddress, eventId, participantAddress], onDelete: Restrict, onUpdate: Cascade)

  @@unique([chainId, contractAddress, transactionHash, logIndex], name: "att_tx_log_unique")
  @@unique([chainId, contractAddress, eventId, participantAddress], name: "att_event_participant_unique")
  @@index([participantAddress])
  @@index([chainId, contractAddress, eventId])
  @@index([blockNumber])
}

/// Blokzincir olay indeksleyicisinin son işlenen blok durumunu tutan tablo
model IndexerCheckpoint {
  id                 String   @id @default(cuid())
  chainId            Int
  contractAddress    String
  lastProcessedBlock Int
  updatedAt          DateTime @updatedAt

  @@unique([chainId, contractAddress], name: "chainId_contractAddress")
}

/// SIWE (EIP-4361) tek kullanımlık kriptografik giriş nonce modeli
model AuthNonce {
  id            String    @id @default(cuid())
  nonce         String    @unique
  walletAddress String?
  domain        String
  chainId       Int
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

/// SIWE doğrulaması sonrası oluşturulan süreli organizatör oturumu
model OrganizerSession {
  id               String    @id @default(cuid())
  sessionTokenHash String    @unique
  csrfToken        String
  walletAddress    String
  chainId          Int
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([walletAddress])
  @@index([expiresAt])
}

/// Doğrulanmış blokzincir katılımları (AttendanceMarked) için kriptografik bütünlüklü dijital sertifika modeli
model AttendanceCertificate {
  id                    String            @id @default(cuid())
  certificateId         String            @unique
  version               String            @default("CP-CERT-V1")
  status                String            @default("ACTIVE")
  chainId               Int
  contractAddress       String
  eventId               Int
  eventTitle            String
  organizerAddress      String
  participantAddress    String
  displayName           String?
  attendanceTxHash      String
  attendanceBlockNumber Int
  attendanceLogIndex    Int
  certificateHash       String            @unique
  integritySignature    String
  metadataUri           String?
  issuedAt              DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([chainId, contractAddress, eventId, participantAddress], name: "cert_event_participant_unique")
  @@index([participantAddress])
  @@index([chainId, contractAddress, eventId])
}


/// Öğrenci profili ve hesap tercihleri modeli (Faz 14)
model StudentProfile {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  displayName   String?
  university    String   @default("Monad Üniversitesi")
  department    String?
  bio           String?
  avatarUrl     String?
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress])
}
